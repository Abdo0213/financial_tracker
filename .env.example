# .env.example
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# --- 1. Speech-to-Text Service (Whisper on Google Colab) ---
# When you run model_server.ipynb on Google Colab, copy the ngrok public URL here:
WHISPER_API_URL=https://your-ngrok-tunnel-id.ngrok-free.app

# --- 2. LLM Provider (Agentic Workflow) ---
# Option A: Ollama Cloud (Current default)
OLLAMA_API_KEY=your-ollama-cloud-key-here
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# Option B: OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Option C: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
